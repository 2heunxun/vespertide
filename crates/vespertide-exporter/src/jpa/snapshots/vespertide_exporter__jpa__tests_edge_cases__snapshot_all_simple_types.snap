import jakarta.persistence.*;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.LocalTime;
import java.time.OffsetDateTime;
import java.util.UUID;

@Entity
@Table(name = "type_matrix")
public class TypeMatrix {

    @Column(name = "c_int", nullable = false)
    private Integer cInt;

    @Column(name = "c_bigint", nullable = false)
    private Long cBigint;

    @Column(name = "c_smallint", nullable = false)
    private Short cSmallint;

    @Column(name = "c_text", columnDefinition = "TEXT")
    private String cText;

    @Column(name = "c_bool", nullable = false)
    private Boolean cBool;

    @Column(name = "c_real", nullable = false)
    private Float cReal;

    @Column(name = "c_double", nullable = false)
    private Double cDouble;

    @Column(name = "c_date")
    private LocalDate cDate;

    @Column(name = "c_time")
    private LocalTime cTime;

    @Column(name = "c_ts")
    private LocalDateTime cTs;

    @Column(name = "c_tstz")
    private OffsetDateTime cTstz;

    @Column(name = "c_interval", columnDefinition = "INTERVAL")
    private String cInterval;

    @Column(name = "c_uuid", nullable = false)
    private UUID cUuid;

    @Column(name = "c_json", columnDefinition = "JSON")
    private String cJson;

    @Column(name = "c_bytea", columnDefinition = "BYTEA")
    private byte[] cBytea;

    @Column(name = "c_inet")
    private String cInet;

    @Column(name = "c_cidr")
    private String cCidr;

    @Column(name = "c_macaddr")
    private String cMacaddr;

    @Column(name = "c_xml", columnDefinition = "TEXT")
    private String cXml;

    protected TypeMatrix() {
    }
}
