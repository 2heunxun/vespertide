import jakarta.persistence.*;

@Entity
@Table(name = "employees")
public class Employees {

    @Id
    @Column(name = "id")
    private Integer id;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "manager_id")
    private Employees manager;

    protected Employees() {
    }
}
