import jakarta.persistence.*;

@Entity
@Table(name = "users")
public class Users {

    @Id
    @Column(name = "id")
    private Integer id;

    @Column(name = "display_name", columnDefinition = "TEXT")
    private String displayName;

    protected Users() {
    }
}
