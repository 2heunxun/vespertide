from __future__ import annotations

from datetime import date, datetime, time
from typing import Optional
from uuid import UUID

from sqlalchemy import BigInteger, Boolean, Date, DateTime, Float, Integer, Interval, JSON, LargeBinary, SmallInteger, String, Text, Time, Uuid
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column


class TypeMatrix(DeclarativeBase):
    __tablename__ = "type_matrix"

    c_int: Mapped[int] = mapped_column(Integer, nullable=False)
    c_bigint: Mapped[int] = mapped_column(BigInteger, nullable=False)
    c_smallint: Mapped[int] = mapped_column(SmallInteger, nullable=False)
    c_text: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    c_bool: Mapped[bool] = mapped_column(Boolean, nullable=False)
    c_real: Mapped[float] = mapped_column(Float, nullable=False)
    c_double: Mapped[float] = mapped_column(Float, nullable=False)
    c_date: Mapped[Optional[date]] = mapped_column(Date, nullable=True)
    c_time: Mapped[Optional[time]] = mapped_column(Time, nullable=True)
    c_ts: Mapped[Optional[datetime]] = mapped_column(DateTime, nullable=True)
    c_tstz: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True), nullable=True)
    c_interval: Mapped[Optional[str]] = mapped_column(Interval, nullable=True)
    c_uuid: Mapped[UUID] = mapped_column(Uuid, nullable=False)
    c_json: Mapped[Optional[dict]] = mapped_column(JSON, nullable=True)
    c_bytea: Mapped[Optional[bytes]] = mapped_column(LargeBinary, nullable=True)
    c_inet: Mapped[Optional[str]] = mapped_column(String(255), nullable=True)
    c_cidr: Mapped[Optional[str]] = mapped_column(String(255), nullable=True)
    c_macaddr: Mapped[Optional[str]] = mapped_column(String(255), nullable=True)
    c_xml: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
