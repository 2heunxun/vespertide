from __future__ import annotations

from django.db import models


class Users(models.Model):
    """User accounts"""

    id = models.AutoField()
    email = models.CharField(max_length=255, unique=True)
    name = models.TextField(null=True, blank=True)

    class Meta:
        db_table = "users"
