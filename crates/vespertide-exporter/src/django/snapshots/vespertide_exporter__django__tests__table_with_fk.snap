from __future__ import annotations

from django.db import models


class Posts(models.Model):
    id = models.AutoField()
    author = models.ForeignKey("Users", on_delete=models.CASCADE, related_name="+")
    title = models.TextField()

    class Meta:
        db_table = "posts"
