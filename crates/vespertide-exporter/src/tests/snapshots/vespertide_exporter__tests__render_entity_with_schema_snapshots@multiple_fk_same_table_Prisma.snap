expression: rendered
---
model Post {
  id String @id @db.Uuid
  creator_user_id String @db.Uuid
  creator_user User @relation("PostCreatorUser", fields: [creator_user_id], references: [id])
  used_by_user_id String @db.Uuid
  used_by_user User @relation("PostUsedByUser", fields: [used_by_user_id], references: [id])

  @@map("post")
}
