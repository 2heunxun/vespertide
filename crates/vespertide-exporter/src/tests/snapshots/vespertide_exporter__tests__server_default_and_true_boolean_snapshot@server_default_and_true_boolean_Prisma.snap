model Logs {
  id Int @id @default(autoincrement())
  active Boolean @default(true)
  created_at DateTime @default(now()) @db.Timestamptz
  score Float @default(1.5) @db.Real
  tag String @default(dbgenerated("UNKNOWN_EXPR")) @db.Text

  @@map("logs")
}
